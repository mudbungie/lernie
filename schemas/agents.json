{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agents",
  "description": "Top-level `agents.yaml` shape.",
  "type": "object",
  "required": [
    "agents"
  ],
  "properties": {
    "agents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/AgentRole"
      }
    }
  },
  "definitions": {
    "AgentRole": {
      "description": "One named agent role: which model to drive it with and where to find its system prompt. `system_prompt` is interpreted relative to `.agent/system/`.",
      "type": "object",
      "required": [
        "model",
        "system_prompt"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "system_prompt": {
          "type": "string"
        }
      }
    }
  }
}