#!/bin/sh
# lernie external tool `slack_read` (ARCH §3.3 triple: binary + schema +
# skill). Reads the mock Slack channel — a flock-guarded NDJSON file under
# the harness data root — and returns every message strictly newer than
# the supplied `oldest` timestamp.
#
#   stdin : {"oldest": "<ts>"}   (optional / nullable → every message)
#   stdout: {"messages":[{"ts","author","text"},...],"latest_ts":"<ts>"}
#
# A channel file that does not exist is an empty channel, not an error:
# empty messages, latest_ts "0", exit 0. JSON handling is python3's; this
# script owns only the lock and the paths.
set -eu

data_root="${LERNIE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/lernie}"
slack_dir="$data_root/slack"
CHANNEL="$slack_dir/channel.ndjson"
lock="$slack_dir/channel.lock"
export CHANNEL

mkdir -p "$slack_dir"
[ -e "$lock" ] || : >>"$lock"

input=$(cat)

# Shared lock: concurrent readers do not exclude each other, but a
# half-written append never becomes a torn read.
exec 9>>"$lock"
flock -s 9

printf '%s' "$input" | python3 -c '
import json, os, sys

try:
    req = json.loads(sys.stdin.read() or "{}")
except ValueError:
    req = {}
if not isinstance(req, dict):
    req = {}
oldest = req.get("oldest")


def num(value):
    try:
        return int(str(value))
    except (TypeError, ValueError):
        return 0


rows = []
try:
    with open(os.environ["CHANNEL"], "r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict):
                rows.append(row)
except FileNotFoundError:
    print(json.dumps({"messages": [], "latest_ts": "0"}))
    sys.exit(0)

cut = None if oldest in (None, "") else num(oldest)
fresh = [r for r in rows if cut is None or num(r.get("ts")) > cut]
latest = max([num(r.get("ts")) for r in rows] + [0])

print(json.dumps({
    "messages": [
        {
            "ts": str(r.get("ts", "0")),
            "author": r.get("author", ""),
            "text": r.get("text", ""),
        }
        for r in fresh
    ],
    "latest_ts": str(latest),
}))
'
