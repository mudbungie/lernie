#!/bin/sh
# lernie external tool `slack_post` (ARCH §3.3 triple: binary + schema +
# skill). Appends one message to the mock Slack channel — a flock-guarded
# NDJSON file under the harness data root.
#
#   stdin : {"text": "..."}
#   stdout: {"ok":true,"ts":"<ts>"}
#
# The author is `$FLEET_SLACK_AUTHOR` (default "Mark H") — agents post
# under their human's account, which is exactly the ambiguity SPEC §6.4
# disambiguates by content. The appended text is therefore suffixed with
# the client's agent marker, which is the content the sensor classifies on.
set -eu

data_root="${LERNIE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/lernie}"
slack_dir="$data_root/slack"
CHANNEL="$slack_dir/channel.ndjson"
lock="$slack_dir/channel.lock"
AUTHOR="${FLEET_SLACK_AUTHOR:-Mark H}"
export CHANNEL AUTHOR

mkdir -p "$slack_dir"
[ -e "$lock" ] || : >>"$lock"

input=$(cat)

# Exclusive lock: the read-max-then-append below is one critical section,
# because two appends racing it would allocate the same timestamp.
exec 9>>"$lock"
flock 9

printf '%s' "$input" | python3 -c '
import json, os, sys, time

try:
    req = json.loads(sys.stdin.read() or "{}")
except ValueError:
    req = {}
if not isinstance(req, dict) or not isinstance(req.get("text"), str):
    sys.stderr.write("slack_post: input must be {\"text\": \"<string>\"}\n")
    sys.exit(1)


def num(value):
    try:
        return int(str(value))
    except (TypeError, ValueError):
        return 0


path = os.environ["CHANNEL"]
highest = 0
try:
    with open(path, "r", encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            highest = max(highest, num(row.get("ts")))
except FileNotFoundError:
    pass

# Strictly increasing integer strings: wall-clock seconds where they are
# ahead of the channel, the successor where they are not.
ts = max(highest + 1, int(time.time()))
row = {
    "ts": str(ts),
    "author": os.environ["AUTHOR"],
    "text": req["text"] + "\n[Sent using <@Claude>]",
}
with open(path, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(row) + "\n")

print(json.dumps({"ok": True, "ts": str(ts)}))
'
