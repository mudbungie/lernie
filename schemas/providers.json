{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Providers",
  "description": "Top-level `providers.yaml` shape.",
  "type": "object",
  "required": [
    "providers"
  ],
  "properties": {
    "models": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Model"
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Provider"
      }
    }
  },
  "definitions": {
    "Auth": {
      "description": "Auth strategy for a provider. The closed set tracks ARCH §4.1.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "env",
            "type"
          ],
          "properties": {
            "env": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "api_key"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "profile",
            "type"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "aws_sigv4"
              ]
            }
          }
        }
      ]
    },
    "Model": {
      "description": "One model declared by some provider.",
      "type": "object",
      "required": [
        "capabilities",
        "context_window",
        "model_id",
        "provider"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_window": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "model_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "Provider": {
      "description": "One inference provider: an (endpoint, auth) pair.",
      "type": "object",
      "required": [
        "auth",
        "endpoint"
      ],
      "properties": {
        "auth": {
          "$ref": "#/definitions/Auth"
        },
        "endpoint": {
          "type": "string"
        }
      }
    }
  }
}